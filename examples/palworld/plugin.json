{
  "id": "palworld",
  "name": "Palworld Dedicated Server",
  "author": "ohmcodes",
  "version": "1.1.4",
  "description": "Palworld Dedicated Server",
  "url": "https://github.com/ohmcodes/WindowsGSM.Palworld",
  "color": "#1E8449",
  "install": { "type": "steamcmd", "appId": "2394010" },
  "exe": "Pal/Binaries/Win64/PalServer-Win64-Shipping-Cmd.exe",
  "defaults": {
    "port": "8211",
    "queryPort": "8212",
    "map": "MainWorld5",
    "maxPlayers": "32",
    "additional": "-publiclobby -logformat=text",
    "portIncrement": 2
  },
  "args": [
    "{param}",
    "-publicip={ip}",
    "-port={port}",
    "-publicport={port}",
    "-players={maxPlayers}",
    "-servername={name}"
  ],
  "query": null
}
