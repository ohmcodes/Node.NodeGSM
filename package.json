{
  "name": "nodegsm",
  "version": "0.1.0",
  "description": "NodeGSM - Node Game Server Manager. Install, run and automate game servers with one click.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node src/server/headless.js",
    "serve:dev": "node --watch src/server/headless.js --port 8731",
    "test": "node test/smoke.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir",
    "icons": "node scripts/build-icons.js"
  },
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cron-parser": "^4.9.0",
    "discord.js": "^14.28.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nodegsm.app",
    "productName": "NodeGSM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "bin": {
    "nodegsm": "src/server/headless.js"
  }
}
