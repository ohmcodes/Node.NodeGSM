{
  "name": "nodegsm",
  "version": "0.1.0",
  "description": "NodeGSM - Node Game Server Manager. Install, run and automate game servers with one click.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cron-parser": "^4.9.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nodegsm.app",
    "productName": "NodeGSM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}