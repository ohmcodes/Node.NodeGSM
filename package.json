{
  "name": "nodegsm",
  "version": "0.1.0",
  "description": "NodeGSM - Node Game Server Manager. Install, run and automate game servers with one click.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.js && node scripts/validate-plugins.js --check",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir",
    "validate:plugins": "node scripts/validate-plugins.js",
    "registry": "node scripts/build-registry.js"
  },
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cron-parser": "^4.9.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nodegsm.app",
    "productName": "NodeGSM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "plugins/**",
      "assets/**",
      "package.json",
      "!plugins/_template/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
