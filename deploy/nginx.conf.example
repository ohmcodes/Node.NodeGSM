# nginx reverse proxy for NodeGSM (web mode) with TLS and WebSocket upgrade.
# NodeGSM itself speaks plain HTTP on 127.0.0.1:8730 (start it with NODEGSM_HTTPS=1 and NODEGSM_TRUST_PROXY=1).
# Certificates: sudo certbot --nginx -d nodegsm.example.com   (or use your own certificate files below).

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 80;
    server_name nodegsm.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name nodegsm.example.com;

    ssl_certificate     /etc/letsencrypt/live/nodegsm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nodegsm.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # backups can be large; API bodies are small (NodeGSM limits them itself)
    client_max_body_size 8m;

    # optional second factor in front of NodeGSM: IP allow list or HTTP basic auth
    # allow 203.0.113.0/24; deny all;
    # auth_basic "NodeGSM"; auth_basic_user_file /etc/nginx/nodegsm.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:8730;
        proxy_http_version 1.1;
        # the Origin check compares Origin with Host: pass the public host name through unchanged
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;      # overwrite, never append client-supplied values
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket (/ws): live status / console / metrics
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
}
