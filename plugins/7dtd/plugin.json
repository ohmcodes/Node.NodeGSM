{
  "$schema": "../plugin.schema.json",
  "id": "7dtd",
  "name": "7 Days to Die Dedicated Server",
  "description": "Dedicated server support for 7 Days to Die. Install, run, configure and monitor it from NodeGSM.",
  "author": "WindowsGSM contributors (ported to NodeGSM)",
  "version": "1.0.0",
  "url": "https://steamdb.info/app/294420/info/",
  "tags": ["steamcmd"],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "294420"
  },
  "run": {
    "exe": "7DaysToDieServer.exe",
    "args": ["-logfile", "7DaysToDieServer_Data/output_log_dedi.txt", "-quit", "-batchmode", "-nographics", "-configfile=serverconfig.xml", "-dedicated", "{param}"]
  },
  "defaults": {
    "port": "26900",
    "queryPort": "26900",
    "map": "Navezgane",
    "maxPlayers": "8",
    "additional": ""
  },
  "query": null,
  "configs": [
    {
      "id": "serverconfig",
      "name": "serverconfig.xml",
      "path": "serverconfig.xml",
      "format": "xml",
      "description": "Server name, ports, world, game rules"
    }
  ],
  "logs": [
    {
      "id": "output-log",
      "name": "Server log",
      "path": "7DaysToDieServer_Data/output_log_dedi*.txt"
    }
  ]
}
