{
  "$schema": "../plugin.schema.json",
  "id": "csgo",
  "name": "Counter-Strike: Global Offensive Dedicated Server",
  "description": "Dedicated server support for Counter-Strike: Global Offensive. Install, run, configure and monitor it from NodeGSM.",
  "author": "WindowsGSM contributors (ported to NodeGSM)",
  "version": "1.0.0",
  "url": "https://steamdb.info/app/740/info/",
  "tags": ["source", "steamcmd"],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "740"
  },
  "run": {
    "exe": "srcds.exe",
    "stdin": false,
    "args": [
      "-console",
      ["-game", "csgo"],
      ["-ip", "{ip}"],
      ["-port", "{port}"],
      ["-maxplayers_override", "{maxPlayers}"],
      ["+sv_setsteamaccount", "{gslt}"],
      "{param}",
      ["+map", "{map}"]
    ]
  },
  "defaults": {
    "port": "27015",
    "queryPort": "27015",
    "map": "de_dust2",
    "maxPlayers": "24",
    "additional": "-tickrate 64 -usercon +game_type 0 +game_mode 0 +mapgroup mg_active"
  },
  "query": "a2s",
  "gslt": true,
  "configs": [
    {
      "id": "server-cfg",
      "name": "server.cfg",
      "path": "csgo/cfg/server.cfg",
      "format": "cfg",
      "description": "Main server config (hostname, rcon_password, ...)"
    }
  ],
  "logs": [
    {
      "id": "server-logs",
      "name": "Server logs",
      "path": "csgo/logs/*.log",
      "description": "Written when \"log on\" is set in server.cfg"
    }
  ]
}
