{
  "$schema": "../plugin.schema.json",
  "id": "se",
  "name": "Space Engineers Dedicated Server",
  "description": "Dedicated server support for Space Engineers. Install, run, configure and monitor it from NodeGSM.",
  "author": "WindowsGSM contributors (ported to NodeGSM)",
  "version": "1.0.0",
  "url": "https://steamdb.info/app/298740/info/",
  "tags": ["steamcmd"],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "298740"
  },
  "run": {
    "exe": "DedicatedServer64/SpaceEngineersDedicated.exe",
    "args": [
      "-noconsole",
      "-ignorelastsession",
      ["-ip", "{ip}"],
      ["-port", "{port}"],
      "{param}"
    ]
  },
  "defaults": {
    "port": "27016",
    "queryPort": "27017",
    "map": "world",
    "maxPlayers": "4",
    "additional": ""
  },
  "query": "a2s"
}
