{
  "$schema": "../plugin.schema.json",
  "id": "mygame",
  "name": "My Game Dedicated Server",
  "description": "One or two sentences: what game, anything special about the server.",
  "author": "your-github-name",
  "version": "1.0.0",
  "url": "https://store.steampowered.com/app/123456",
  "tags": ["survival", "steamcmd"],
  "docs": [
    { "title": "Official dedicated server guide", "url": "https://example.com/official-guide", "type": "official", "description": "Published by the developer" },
    { "title": "Community wiki: setting up a server", "url": "https://example.com/wiki/server", "type": "unofficial" },
    { "title": "Video walkthrough", "url": "https://example.com/video", "type": "unofficial" }
  ],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "steps": [
      { "type": "steamcmd", "appId": "123456" },
      { "type": "mkdir", "path": "MyGame/Saved/Config" },
      { "type": "write", "path": "MyGame/Saved/Config/server.ini", "content": "[Server]\nName={name}\nPort={port}\n" }
    ]
  },
  "run": {
    "exe": "MyGame/Binaries/Win64/MyGameServer.exe",
    "args": [
      "{param}",
      "-log",
      ["-port", "{port}"],
      ["-queryport", "{queryPort}"],
      "-MaxPlayers={maxPlayers}",
      "-ServerName={name}"
    ]
  },
  "defaults": {
    "port": "7777",
    "queryPort": "27015",
    "map": "",
    "maxPlayers": "16",
    "additional": ""
  },
  "query": "a2s",
  "configs": [
    {
      "id": "server-ini",
      "name": "server.ini",
      "path": "MyGame/Saved/Config/server.ini",
      "format": "ini",
      "description": "Main server settings"
    },
    {
      "id": "admins",
      "name": "admins.json",
      "path": "MyGame/Saved/admins.json",
      "format": "json",
      "description": "Admin list",
      "template": "templates/admins.json"
    }
  ],
  "metrics": [
    {
      "id": "fps",
      "name": "Server FPS",
      "unit": "fps",
      "source": "console",
      "pattern": "fps[:= ]+([0-9.]+)",
      "command": "fps",
      "intervalSec": 10,
      "description": "Optional: shown as a column on the Table and Dashboard views"
    }
  ],
  "logs": [
    {
      "id": "server-log",
      "name": "Server log",
      "path": "MyGame/Saved/Logs/*.log",
      "description": "Wildcards allowed - the newest matching file is followed"
    }
  ]
}
