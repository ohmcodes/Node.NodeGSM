{
  "$schema": "../plugin.schema.json",
  "id": "mygame",
  "name": "My Game Dedicated Server",
  "description": "One or two sentences: what game, anything special about the server.",
  "author": "your-github-name",
  "version": "1.0.0",
  "url": "https://store.steampowered.com/app/123456",
  "tags": ["survival", "steamcmd"],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "steps": [
      { "type": "steamcmd", "appId": "123456" },
      { "type": "mkdir", "path": "MyGame/Saved/Config" },
      { "type": "write", "path": "MyGame/Saved/Config/server.ini", "content": "[Server]\nName={name}\nPort={port}\n" }
    ]
  },
  "run": {
    "exe": "MyGame/Binaries/Win64/MyGameServer.exe",
    "args": [
      "{param}",
      "-log",
      ["-port", "{port}"],
      ["-queryport", "{queryPort}"],
      "-MaxPlayers={maxPlayers}",
      "-ServerName={name}"
    ]
  },
  "defaults": {
    "port": "7777",
    "queryPort": "27015",
    "map": "",
    "maxPlayers": "16",
    "additional": ""
  },
  "query": "a2s",
  "configs": [
    {
      "id": "server-ini",
      "name": "server.ini",
      "path": "MyGame/Saved/Config/server.ini",
      "format": "ini",
      "description": "Main server settings"
    },
    {
      "id": "admins",
      "name": "admins.json",
      "path": "MyGame/Saved/admins.json",
      "format": "json",
      "description": "Admin list",
      "template": "templates/admins.json"
    }
  ],
  "logs": [
    {
      "id": "server-log",
      "name": "Server log",
      "path": "MyGame/Saved/Logs/*.log",
      "description": "Wildcards allowed - the newest matching file is followed"
    }
  ]
}
