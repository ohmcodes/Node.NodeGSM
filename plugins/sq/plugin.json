{
  "$schema": "../plugin.schema.json",
  "id": "sq",
  "name": "Squad Dedicated Server",
  "description": "Dedicated server support for Squad. Install, run, configure and monitor it from NodeGSM.",
  "author": "WindowsGSM contributors (ported to NodeGSM)",
  "version": "1.0.0",
  "url": "https://steamdb.info/app/403240/info/",
  "tags": ["unreal", "steamcmd"],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "403240"
  },
  "run": {
    "exe": "SquadGame/Binaries/Win64/SquadGameServer.exe",
    "args": ["-log", "MULTIHOME={ip}", "Port={port}", "QueryPort={queryPort}", "FIXEDMAXPLAYERS={maxPlayers}", "{param}"]
  },
  "defaults": {
    "port": "7787",
    "queryPort": "27165",
    "map": "",
    "maxPlayers": "80",
    "additional": "RANDOM=ALWAYS"
  },
  "query": "a2s",
  "configs": [
    {
      "id": "server-cfg",
      "name": "Server.cfg",
      "path": "SquadGame/ServerConfig/Server.cfg",
      "format": "cfg",
      "description": "Server name, max players, password"
    },
    {
      "id": "admins",
      "name": "Admins.cfg",
      "path": "SquadGame/ServerConfig/Admins.cfg",
      "format": "cfg"
    }
  ],
  "logs": [
    {
      "id": "squadgame",
      "name": "SquadGame.log",
      "path": "SquadGame/Saved/Logs/SquadGame.log"
    }
  ]
}
