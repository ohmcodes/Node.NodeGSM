{
  "$schema": "../plugin.schema.json",
  "id": "l4d2",
  "name": "Left 4 Dead 2 Dedicated Server",
  "description": "Dedicated server support for Left 4 Dead 2. Install, run, configure and monitor it from NodeGSM.",
  "author": "WindowsGSM contributors (ported to NodeGSM)",
  "version": "1.0.0",
  "url": "https://steamdb.info/app/222860/info/",
  "tags": ["source", "steamcmd"],
  "media": {
    "icon": "icon.png",
    "readme": "README.md",
    "screenshots": []
  },
  "install": {
    "type": "steamcmd",
    "appId": "222860"
  },
  "run": {
    "exe": "srcds.exe",
    "stdin": false,
    "args": [
      "-console",
      ["-game", "left4dead2"],
      ["-ip", "{ip}"],
      ["-port", "{port}"],
      ["-maxplayers", "{maxPlayers}"],
      ["+sv_setsteamaccount", "{gslt}"],
      "{param}",
      ["+map", "{map}"]
    ]
  },
  "defaults": {
    "port": "27015",
    "queryPort": "27015",
    "map": "c1m1_hotel",
    "maxPlayers": "24",
    "additional": "-nocrashdialog"
  },
  "query": "a2s",
  "gslt": true,
  "configs": [
    {
      "id": "server-cfg",
      "name": "server.cfg",
      "path": "left4dead2/cfg/server.cfg",
      "format": "cfg",
      "description": "Main server config (hostname, rcon_password, ...)"
    }
  ],
  "logs": [
    {
      "id": "server-logs",
      "name": "Server logs",
      "path": "left4dead2/logs/*.log",
      "description": "Written when \"log on\" is set in server.cfg"
    }
  ]
}
